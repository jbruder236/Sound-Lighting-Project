Screen { background: #10171e; color: #dce6eb; }
#page { padding: 1 2; }
#brand { color: #6ee7c4; text-style: bold; height: 1; }
#subtitle { color: #8a9da9; margin-bottom: 1; height: 1; }
#health { background: #1a2932; padding: 0 1; height: 1; margin-bottom: 1; }
#panels { height: auto; }
.panel { border: round #344752; padding: 0 2; height: auto; }
#controls { width: 1fr; margin-right: 1; }
#monitor { width: 1fr; }
#panels.narrow { layout: vertical; }
#panels.narrow #controls { width: 100%; margin: 0 0 1 0; }
#panels.narrow #monitor { width: 100%; }
.eyebrow { color: #6ee7c4; text-style: bold; margin-bottom: 1; }
Label { color: #adbdc6; height: 1; }
Select { margin: 0 0 1 0; }
.row { height: 3; }
Button { min-width: 8; width: 1fr; margin-right: 1; background: #25353f; border: tall #25353f; }
Button:hover { background: #36545d; border: tall #36545d; }
Button.-primary { background: #246c5d; border: tall #246c5d; }
Input { width: 1fr; }
#saved { color: #ffbf69; height: 2; margin-top: 1; }
#mode { text-style: bold; color: #ffbf69; height: 2; }
#level { height: 1; }
ProgressBar { height: 1; margin: 1 0; }
ProgressBar Bar { width: 1fr; }
ProgressBar .bar--bar { color: #6ee7c4; }
#wave { height: 3; color: #6ee7c4; background: #16232b; }
.muted { color: #8a9da9; height: auto; }
#capture { margin-top: 1; height: auto; }
#connection { margin-top: 1; }
#route { height: auto; }
#runtime { color: #8a9da9; height: auto; margin-top: 1; }
Footer { background: #1a2932; }
ColorPicker { align: center middle; background: #071015 80%; }
#picker { width: 68; max-width: 95%; height: auto; padding: 1 2; border: round #6ee7c4; background: #16232b; }
#picker Static { height: auto; }
#picker #swatch { height: 3; margin: 1 0; }
#picker #color-error { height: 2; color: #ffbf69; }
