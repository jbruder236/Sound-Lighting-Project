#!/usr/bin/env bash
# Sound Lighting command for the supported Pi installation.
if [[ ${1:-} == tui ]]; then
  shift
  tui_python=/home/pi/.local/share/sound-lighting/tui-venv/bin/python
  if [[ ! -x "$tui_python" ]]; then
    echo 'Install the optional dashboard: bash install/install-tui.sh' >&2
    exit 1
  fi
  exec "$tui_python" /home/pi/Sound-Lighting-Project/tools/dashboard.py "$@"
fi
exec /usr/bin/python3 /home/pi/Sound-Lighting-Project/tools/lights.py "$@"
